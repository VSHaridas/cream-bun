# ─────────────────────────────────────────────────────────────────────────────
#  CREAM — environment template
#
#  Copy to `.env.local` and fill in what you need. Nothing here is required to
#  run the app: with an empty file every subsystem uses its sandbox or seed
#  adapter and the prototype behaves identically.
#
#  The important distinction, which the app also enforces at runtime:
#  a credential being present is NOT the same as a subsystem being live.
#  Only Supabase and Gemini have a real network call behind them today.
#  Razorpay, DigiLocker and SynthID stay on their sandbox adapters by design.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase · auth + full datastore ─────────────────────────────────────────
# Supabase → Project Settings → Data API
#   Project URL            → NEXT_PUBLIC_SUPABASE_URL
#   anon / publishable key → NEXT_PUBLIC_SUPABASE_ANON_KEY
# Supabase → Project Settings → API Keys  (server only, never expose)
#   service_role key       → SUPABASE_SERVICE_ROLE_KEY
#
# MUST NOT be prefixed NEXT_PUBLIC_. It bypasses row-level security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Only needed when the cookie domain must be pinned explicitly,
# e.g. an apex domain serving www and bare hosts.
# NEXT_PUBLIC_SUPABASE_COOKIE_DOMAIN=

# ── Google Gemini · brief builder ────────────────────────────────────────────
# Google AI Studio → Get API key. Server-only; never prefix NEXT_PUBLIC_.
#
# The model is NOT configured here. The UI reads the catalogue this key can
# call from the API and the user picks, so a new release needs no code change.
GEMINI_API_KEY=

# ── DigiLocker · identity (sandbox adapter by design) ────────────────────────
# Not yet wired to the DigiLocker consent API. Supplying a client id does not
# change behaviour — the app says so rather than pretending otherwise.
NEXT_PUBLIC_DIGILOCKER_CLIENT_ID=
NEXT_PUBLIC_DIGILOCKER_CLIENT_SECRET=
NEXT_PUBLIC_DIGILOCKER_API_VERSION=v2.0
NEXT_PUBLIC_DIGILOCKER_ENV=sandbox

# ── Razorpay · escrow (sandbox adapter by design) ────────────────────────────
# Not yet wired to the Razorpay Orders API. The sandbox adapter reproduces the
# exact object shapes and state transitions.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
NEXT_PUBLIC_RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_WEBHOOK_SECRET=

# ── SynthID / C2PA · provenance (local stamper by design) ────────────────────
NEXT_PUBLIC_SYNTHID_WATERMARK_ENDPOINT=
NEXT_PUBLIC_SYNTHID_API_KEY=
NEXT_PUBLIC_C2PA_SIGNING_CERT=

# ── Application ───────────────────────────────────────────────────────────────
# In production this must be the deployed origin, not localhost: it is what the
# OAuth redirect and the session cookie origin are built from.
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_SECRET=change-me-in-production